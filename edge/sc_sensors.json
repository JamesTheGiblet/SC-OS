{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-capsule.dev/sc_sensors.json",
  "title": "Edge sensor list (device to gateway)",
  "type": "object",
  "required": ["src", "sensors"],
  "additionalProperties": false,
  "properties": {
    "src": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,15}$" },
    "sensors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "type", "bus", "pin", "unit", "min", "max", "margin_low", "margin_high", "sample_ms"],
        "additionalProperties": false,
        "properties": {
          "id":          { "type": "string", "pattern": "^[a-z0-9_]{1,24}$" },
          "type":        { "type": "string", "minLength": 1, "maxLength": 32 },
          "bus":         { "type": "string", "minLength": 1, "maxLength": 32 },
          "pin":         { "type": "string", "minLength": 1, "maxLength": 16 },
          "unit":        { "type": "string", "minLength": 1, "maxLength": 12 },
          "min":         { "type": "number" },
          "max":         { "type": "number" },
          "margin_low":  { "type": "number" },
          "margin_high": { "type": "number" },
          "sample_ms":   { "type": "integer", "minimum": 1 }
        }
      }
    },
    "absent": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    }
  }
}
